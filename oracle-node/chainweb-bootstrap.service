[Unit]
Description=Download and verify the initial Kadena Community compacted snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=chainweb
Group=chainweb
StateDirectory=chainweb
StateDirectoryMode=0750
ExecStart=/usr/local/lib/chainweb/bootstrap.sh
TimeoutStartSec=infinity
RemainAfterExit=yes
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chainweb
